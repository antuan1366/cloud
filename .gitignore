*.pem
*.key
id_rsa
id_ed25519
.aws/
.ssh/

# Environment variables and secrets
.env
.env.*
!.env.example
secrets/
credentials/
*.secret

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Ansible runtime/secret files
*.retry
vault-password-file
